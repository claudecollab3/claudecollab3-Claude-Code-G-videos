# --- App ---
APP_NAME=trading-bot
APP_ENV=development          # development | staging | production
APP_DEBUG=true
LOG_LEVEL=INFO

# --- API / Security ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CREDENTIAL_ENCRYPTION_KEY=change-me-fernet-key-base64
TWO_FACTOR_ISSUER=TradingBot

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_bot
POSTGRES_USER=trading_bot
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://trading_bot:change-me@localhost:5432/trading_bot

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Broker: MetaTrader ---
MT5_ENABLED=false
MT5_LOGIN=
MT5_PASSWORD=
MT5_INVESTOR_PASSWORD=
MT5_SERVER=
MT5_BROKER=

MT4_ENABLED=false
MT4_BRIDGE_HOST=127.0.0.1
MT4_BRIDGE_PORT=5555
MT4_LOGIN=
MT4_PASSWORD=
MT4_SERVER=
MT4_BROKER=

# --- Trading defaults ---
TRADING_MODE=paper            # manual | semi_auto | full_auto | paper | backtest
CONFIDENCE_THRESHOLD=90
RISK_PER_TRADE_PERCENT=1.0
MAX_DAILY_LOSS_PERCENT=3.0
MAX_WEEKLY_LOSS_PERCENT=6.0
MAX_DRAWDOWN_PERCENT=10.0
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=10
MAX_SPREAD_POINTS=30
MAX_SLIPPAGE_POINTS=10
DAILY_PROFIT_TARGET_PERCENT=2.0
TRADE_NEWS_BLACKOUT_MINUTES=30

# --- News engine ---
ECONOMIC_CALENDAR_API_KEY=
ECONOMIC_CALENDAR_BASE_URL=
NEWS_TRADING_ENABLED=false

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# --- Monitoring ---
SENTRY_DSN=
